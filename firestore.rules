rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{u} { allow read, write: if request.auth != null && request.auth.uid == u; }
    match /numbers/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /chats/{c} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.uids;
      match /messages/{m} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.uids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.uids
          && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
